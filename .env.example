# PostgreSQL connection string supplied by your managed database provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="replace-with-at-least-32-random-characters"
# Server-side only: never add NEXT_PUBLIC_ or the key would be bundled for browsers.
MISTRAL_API_KEY="replace-with-your-mistral-key"
# Required by the idempotent demo seed. Use unique values in every environment.
DEMO_ADMIN_PASSWORD="replace-with-a-strong-unique-password"
DEMO_REVIEWER_PASSWORD="replace-with-a-different-strong-password"
